# Copie este arquivo para .env e preencha.

# Endereço da Evolution API (o mesmo do ZapBroker)
EVOLUTION_API_URL=https://zapbroker-evolution-api.mnfvp3.easypanel.host
EVOLUTION_API_KEY=cole-a-chave-aqui

# Nome da instância do número que vai disparar (use um número separado, NÃO o principal da Casa Mar)
EVOLUTION_INSTANCE=casamar-disparo

# Quem recebe o aviso quando um lead responde (com DDI+DDD, separados por vírgula)
AVISAR_NUMEROS=5551980985330

# Grupos do WhatsApp que também recebem o aviso (JID do grupo, separados por vírgula).
# Descubra o JID com: GET /group/fetchAllGroups/{instance}?getParticipants=false
AVISAR_GRUPOS=120363429524605097@g.us

# Opcional: porta para receber respostas na hora via webhook (só se a Evolution alcançar esta máquina).
# Sem isso, o script busca respostas a cada 2 minutos, o que já funciona.
# WEBHOOK_PORTA=3333
